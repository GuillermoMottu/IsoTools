TOOL_PAGE_ID=compare_planned_vs_actual
PORT=3000
ISOTOOLS_API_URL=https://api-events.orcalabs.mx/api/v1
ISOTOOLS_API_KEY=
TOOL_STATE_DIR=.tool-state
TOOL_CONSUMER_ENABLED=false
# Mounted JSON containing organization_id/sales_plans and optional projects; see docs/TPP_PROJECT_CONTEXT.md.
TOOL_BUSINESS_CONFIG_FILE=
# Blank on first boot starts at the current tip; set a reviewed cursor only for intentional replay.
TOOL_INITIAL_CURSOR=
# Production requires SSO. Logto names are accepted without duplicating OIDC_*.
ISSUER_ENDPOINT=
APP_ID=
APP_SECRETS=
# Optional explicit OIDC names take precedence over the Logto aliases.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://cpa.orcalabs.mx/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://api-events.orcalabs.mx/
OIDC_SCOPES=openid profile email roles
SESSION_SECRET=
SESSION_COOKIE_NAME=cpa_session
SESSION_INSECURE_COOKIES=false
# Optional machine credential for protected tool APIs; never reuse ISOTOOLS_API_KEY.
TOOL_API_KEY=
