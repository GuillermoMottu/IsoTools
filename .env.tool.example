TOOL_PAGE_ID=compare_planned_vs_actual
PORT=3000
ISOTOOLS_API_URL=https://api-events.orcalabs.mx/api/v1
ISOTOOLS_API_KEY=
TOOL_STATE_DIR=.tool-state
TOOL_CONSUMER_ENABLED=false
# Mounted JSON containing organization_id and sales_plans; see docs/CHECKLIST_COMPARE_TRACK.md.
TOOL_BUSINESS_CONFIG_FILE=
# Blank on first boot starts at the current tip; set a reviewed cursor only for intentional replay.
TOOL_INITIAL_CURSOR=
# Keep OIDC_ISSUER and TOOL_API_KEY unset during the leader's open-mode phase.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
SESSION_SECRET=
SESSION_COOKIE_NAME=cpa_session
